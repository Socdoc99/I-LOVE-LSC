rules_version = '2';

// Reglas de seguridad de Cloud Storage para I Love LSC (prototipo 1.0.1).
// Pégalas en: Firebase Console -> Storage -> Reglas -> Publicar.
service firebase.storage {
  match /b/{bucket}/o {

    // Videos de las señas: solo lectura para personas con sesión iniciada.
    // Se suben desde la consola de Firebase (que no pasa por estas reglas).
    match /videos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Foto de perfil: cada persona maneja solo su archivo (<uid>.jpg),
    // imágenes de máximo 2 MB.
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }
  }
}
